# Trusted HTTPS endpoints that initialize and verify Paystack transactions.
# These endpoints must keep PAYSTACK_SECRET_KEY on the server and authenticate
# the Firebase ID token sent in the Authorization header.
VITE_PAYSTACK_INITIALIZE_URL=https://your-api.example.com/payments/paystack/initialize
VITE_PAYSTACK_VERIFY_URL=https://your-api.example.com/payments/paystack/verify
VITE_RESERVATION_FINALIZE_URL=https://your-api.example.com/payments/paystack/finalize-reservation
VITE_PAYMENT_STATUS_URL=https://your-api.example.com/payments/paystack/status

# Comma-separated production origins accepted by Firebase Functions.
# Set this in the Functions runtime environment, not in the browser build.
NIVOX_ALLOWED_ORIGINS=https://nivox.example.com
