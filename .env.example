# Trusted HTTPS endpoints that initialize and verify Paystack transactions.
# These endpoints must keep PAYSTACK_SECRET_KEY on the server and authenticate
# the Firebase ID token sent in the Authorization header.
VITE_PAYSTACK_INITIALIZE_URL=https://europe-west1-YOUR_PROJECT_ID.cloudfunctions.net/initializePaystackPayment
VITE_PAYSTACK_VERIFY_URL=https://europe-west1-YOUR_PROJECT_ID.cloudfunctions.net/verifyPaystackPayment
VITE_RESERVATION_FINALIZE_URL=https://europe-west1-YOUR_PROJECT_ID.cloudfunctions.net/finalizeReservation
VITE_PAYMENT_STATUS_URL=https://europe-west1-YOUR_PROJECT_ID.cloudfunctions.net/updatePaymentStatus

# Comma-separated production origins accepted by Firebase Functions.
# Set this in the Functions runtime environment, not in the browser build.
NIVOX_ALLOWED_ORIGINS=https://your-production-domain.example,https://your-preview-domain.example
VITE_ADMIN_BOOTSTRAP_URL=https://us-central1-nivoxhub.cloudfunctions.net/bootstrapAdmin

# Local development only. Never set this to true in a production deployment.
VITE_ALLOW_DEV_ADMIN_BOOTSTRAP=true
