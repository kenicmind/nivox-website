rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDevelopmentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/adminConfig)
        && get(/databases/$(database)/documents/system/adminConfig).data.configured == true
        && get(/databases/$(database)/documents/system/adminConfig).data.authorizationMode == 'development-firestore-role'
        && get(/databases/$(database)/documents/system/adminConfig).data.configuredBy == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || isDevelopmentAdmin());
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.role == 'student'
          || (
            request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/system/adminConfig)
            && getAfter(/databases/$(database)/documents/system/adminConfig).data.configured == true
            && getAfter(/databases/$(database)/documents/system/adminConfig).data.configuredBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/system/adminConfig).data.authorizationMode == 'development-firestore-role'
          )
        );
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role == 'student'
            && request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/system/adminConfig)
            && getAfter(/databases/$(database)/documents/system/adminConfig).data.configured == true
            && getAfter(/databases/$(database)/documents/system/adminConfig).data.configuredBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/system/adminConfig).data.authorizationMode == 'development-firestore-role'
          )
        );
      allow delete: if isAdmin();
    }

    match /system/adminConfig {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/adminConfig)
        && request.resource.data.configured == true
        && request.resource.data.configuredBy == request.auth.uid
        && request.resource.data.authorizationMode == 'development-firestore-role'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /payment_verifications/{reference} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /payment_attempts/{reference} {
      allow read, write: if false;
    }

    match /seat_reservations/{seatKey} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if isAdmin()
        || (isOwner(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        || (isOwner(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled');
      allow create, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.uid) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
