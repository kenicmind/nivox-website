rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    match /learning-materials/{fileName} {
      allow read: if true;
      allow write, delete: if isAdmin()
        && request.resource == null || (isAdmin() && request.resource.contentType == 'application/pdf');
    }
  }
}
